# 博通工单系统 - 环境变量配置
# 复制此文件为 .env 并填入实际值

# ===== 必须 =====
# Flask 密钥 (生产环境必须设置，否则每次重启 session 失效)
BOTO_SECRET_KEY=change_me_to_a_random_string_64chars

# 访问密码 (系统登录密码)
BOTO_ACCESS_PASSWORD=change_me_to_your_password

# ===== 可选 =====
# 服务端口 (默认 5052)
BOTO_PORT=5052

# 调试模式 (生产环境保持 0)
BOTO_DEBUG=0

# Redis URL (不设置则使用 LocalQueue 本地队列)
# REDIS_URL=redis://localhost:6379/0

# 缓存类型 (SimpleCache / RedisCache)
# BOTO_CACHE_TYPE=SimpleCache

# 限流关闭 (生产环境不要设置)
# BOTO_NO_RATE_LIMIT=1

# 日志级别
# BOTO_LOG_LEVEL=info

# Gunicorn Worker 数
# BOTO_WORKERS=2
# BOTO_THREADS=4
