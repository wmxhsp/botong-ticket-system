{
  "name": "botong-frontend",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:fast": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint:fix": "eslint src --ext .js,.vue --fix",
    "format": "prettier --write \"src/**/*.{js,vue,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,vue,css,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.1",
    "@vueuse/core": "^14.3.0",
    "@vueuse/integrations": "^14.3.0",
    "axios": "^1.7.0",
    "bootstrap": "^5.3.3",
    "chart.js": "^4.4.0",
    "date-fns": "^4.3.0",
    "echarts": "^6.1.0",
    "file-saver": "^2.0.5",
    "lodash-es": "^4.18.1",
    "pinia": "^2.1.0",
    "qrcode.vue": "^3.9.1",
    "vue": "^3.4.0",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^11.4.4",
    "vue-router": "^4.3.0",
    "vue-virtual-scroller": "^2.0.0-beta.8",
    "vue3-clipboard": "^1.0.0",
    "vue3-print-nb": "^0.1.4",
    "vuedraggable": "^2.24.3",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tsconfig/node20": "^20.1.9",
    "@types/file-saver": "^2.0.7",
    "@types/lodash-es": "^4.17.12",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.10",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.9.1",
    "happy-dom": "^20.9.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vite": "^5.4.0",
    "vitest": "^4.1.7",
    "vue-tsc": "^3.3.2"
  }
}
